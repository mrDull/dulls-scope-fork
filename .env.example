# copy this file to .env and fill in the value(s).
# .env is gitignored so this never gets committed.

# .ROBLOSECURITY cookie. used by /notify and /lookup for cookie-auth endpoints.
# get it from your browser devtools while logged into roblox.com.
# DO NOT SHARE THIS. its account-level auth.
ROBLOX_COOKIE=your_roblosecurity_cookie_here
